# Copy to .env.local. Never commit real values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
# Optional separate administration origin served by the same deployment.
ADMIN_SITE_URL=
# Server-only. Used by the worker gateway and by Stripe payment recording.
SUPABASE_SERVICE_ROLE_KEY=
CONTENT_WORKER_TOKEN=
# Stripe hosted Checkout. STRIPE_MODE is test or live; keys must match the mode.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# C09 transactional email (server only; see EMAIL.md). Leave blank to keep delivery off.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_DISPATCH_TOKEN=
EMAIL_FROM=
EMAIL_REPLY_TO=
